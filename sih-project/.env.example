# ==============================================================================
# LM-VISION REACT FRONTEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================

# Set this to your ngrok backend URL when exposing to remote reviewers or mobile devices
REACT_APP_API_URL=http://localhost:5000/api

# Enable access via ngrok domains without Webpack Host Header blocking
DANGEROUSLY_DISABLE_HOST_CHECK=true
WDS_SOCKET_PORT=0
HOST=0.0.0.0
