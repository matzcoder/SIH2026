# ==============================================================================
# LM-VISION REACT FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API Base URL
# For local development: http://localhost:5000/api
# For Ngrok deployment: https://<your-backend-subdomain>.ngrok-free.app/api
REACT_APP_API_URL=http://localhost:5000/api

# Enable access via ngrok domains without Webpack Host Header blocking
DANGEROUSLY_DISABLE_HOST_CHECK=true
WDS_SOCKET_PORT=0
HOST=0.0.0.0
